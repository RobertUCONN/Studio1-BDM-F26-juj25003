      "source": [
        "years_span = (closes15.index[-1] - closes15.index[0]).days / 365.25\n",
        "RISK_FREE = 0.02\n",
        "\n",
        "rows = []\n",
        "for t in tickers_15y:\n",
        "    s = closes15[t].dropna()\n",
        "    cagr = (s.iloc[-1] / s.iloc[0]) ** (1 / years_span) - 1\n",
        "    daily_ret = np.log(s / s.shift(1)).dropna()\n",
        "    ann_vol = daily_ret.std() * np.sqrt(252)\n",
        "    sharpe = (cagr - RISK_FREE) / ann_vol\n",
        "    max_dd = (s / s.cummax() - 1).min()\n",
        "    rows.append({\"ticker\": t, \"cagr\": cagr, \"ann_vol\": ann_vol, \"sharpe\": sharpe, \"max_drawdown\": max_dd})\n",
        "\n",
        "summary15 = pd.DataFrame(rows).set_index(\"ticker\").sort_values(\"sharpe\", ascending=False)\n",
        "summary15.style.format({\"cagr\": \"{:.1%}\", \"ann_vol\": \"{:.1%}\", \"sharpe\": \"{:.2f}\", \"max_drawdown\": \"{:.1%}\"})"
      ],
